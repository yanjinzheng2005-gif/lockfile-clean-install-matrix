{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yanjinzheng2005-gif/lockfile-clean-install-matrix/blob/main/schema/config.schema.json",
  "title": "Lockfile Clean Install Matrix config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manager",
    "baselineVersion",
    "candidateVersion",
    "nodeVersion"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectPath": { "$ref": "#/$defs/safeRelativePath", "default": "." },
    "manager": { "enum": ["npm", "pnpm"] },
    "baselineVersion": { "$ref": "#/$defs/exactVersion" },
    "candidateVersion": { "$ref": "#/$defs/exactVersion" },
    "nodeVersion": { "$ref": "#/$defs/exactVersion" },
    "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600, "default": 600 },
    "registry": { "const": "https://registry.npmjs.org", "default": "https://registry.npmjs.org" },
    "outputDir": { "$ref": "#/$defs/safeRelativePath", "default": "lockfile-matrix-results" }
  },
  "allOf": [
    {
      "if": { "properties": { "manager": { "const": "pnpm" } }, "required": ["manager"] },
      "then": {
        "properties": {
          "baselineVersion": { "$ref": "#/$defs/safePnpmVersion" },
          "candidateVersion": { "$ref": "#/$defs/safePnpmVersion" }
        }
      }
    }
  ],
  "$defs": {
    "exactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
          { "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)" }
        ]
      }
    },
    "safePnpmVersion": {
      "type": "string",
      "anyOf": [
        { "pattern": "^10\\.34\\.2$" },
        { "pattern": "^10\\.34\\.(?:[3-9]|[1-9][0-9]+)(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$" },
        { "pattern": "^10\\.(?:3[5-9]|[4-9][0-9]|[1-9][0-9]{2,})\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$" },
        { "pattern": "^11\\.5\\.3$" },
        { "pattern": "^11\\.5\\.(?:[4-9]|[1-9][0-9]+)(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$" },
        { "pattern": "^11\\.(?:[6-9]|[1-9][0-9]+)\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$" },
        { "pattern": "^(?:1[2-9]|[2-9][0-9]|[1-9][0-9]{2,})\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$" }
      ]
    }
  }
}
